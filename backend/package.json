{
  "name": "chapterly-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chapterly API server (Express + PostgreSQL migrations).",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test tests/*.test.js",
    "migrate": "node --import dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down": "node --import dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "migrate:create": "node --import dotenv/config ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create"
  },
  "engines": {
    "node": ">=20.11"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "node-pg-migrate": "^8.0.4",
    "supertest": "^7.0.0"
  }
}
